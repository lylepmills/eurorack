diff --git a/plaits/stock_scene_check.h b/plaits/stock_scene_check.h
new file mode 100644
index 00000000..d868a0a6
--- /dev/null
+++ b/plaits/stock_scene_check.h
@@ -0,0 +1,208 @@
+// Rubato Audio private diagnostic, grafted onto UPSTREAM Plaits (ebe6bbf6):
+// the same fixed-scene cost bracket as the fork's plaits/scene_check.h
+// (interrupt entry to the end of Voice::Render, split at Ui::Poll's end and
+// around the engine's Render, plus Ui::Poll's round-robin task), reported in
+// the same FSK packets, so overrun_sweep_host.py decodes both. Production
+// signal path otherwise untouched. Not for release.
+
+#ifndef PLAITS_STOCK_SCENE_CHECK_H_
+#define PLAITS_STOCK_SCENE_CHECK_H_
+
+#include <stdint.h>
+#include "plaits/diagnostic_fsk.h"
+#include "plaits/dsp/dsp.h"
+#include "plaits/dsp/voice.h"
+#include <stm32f37x_conf.h>
+
+namespace plaits {
+
+struct StockScene {
+  int engine;
+  float harmonics, timbre, morph, note;
+  uint8_t triggered;
+};
+
+template <int kScenes>
+class StockSceneCheck {
+ public:
+  enum Phase { PHASE_START, PHASE_SCENES, PHASE_REPORT };
+  static const int kBlocksPerSecond = 3989;
+  static const int kStartBlocks = 3 * kBlocksPerSecond;
+  static const int kSceneBlocks = 20 * kBlocksPerSecond;
+  static const int kSwitchBlocks = kBlocksPerSecond / 2;
+  static const int kTriggerPeriod = kBlocksPerSecond / 4;
+  static const int kTriggerLength = 4;
+  static const int kSections = 4;
+  static const int kUiTasks = 4;
+
+  void Init(const StockScene* scenes) {
+    CoreDebug->DEMCR |= CoreDebug_DEMCR_TRCENA_Msk;
+    DWT->CYCCNT = 0;
+    DWT->CTRL |= DWT_CTRL_CYCCNTENA_Msk;
+    scenes_ = scenes;
+    phase_ = PHASE_START;
+    scene_ = block_ = 0;
+    budget_ = static_cast<uint32_t>(
+        kBlockSize * (static_cast<float>(F_CPU) / kSampleRate));
+    for (int i = 0; i < kScenes; ++i) {
+      Stats& s = stats_[i];
+      s.max = s.sum = s.switch_max = s.count = 0;
+      for (int k = 0; k < kSections; ++k) s.section_sum[k] = s.section_max[k] = 0;
+    }
+    for (int k = 0; k < kUiTasks; ++k) task_sum_[k] = task_max_[k] = task_count_[k] = 0;
+    ui_task_ = -1;
+    fsk_.Init();
+    report_scene_ = report_gap_ = 0;
+    fsk_.BeginPacket(1, 8);
+    fsk_.Put(2); fsk_.Put(0xfe); fsk_.Put(kScenes); fsk_.Put(0);
+    fsk_.Put16(static_cast<uint16_t>(kSceneBlocks / 4));
+    fsk_.Put16(static_cast<uint16_t>(kStartBlocks));
+    fsk_.EndPacket();
+  }
+
+  bool reporting() const { return phase_ == PHASE_REPORT; }
+
+  inline void BeginCallback() {
+    start_ = DWT->CYCCNT;
+    mark_[1] = mark_[2] = mark_[3] = start_;
+    ui_task_ = -1;
+  }
+  inline void Mark(int k) { mark_[k] = DWT->CYCCNT; }
+  inline void UiTask(int task) { task_mark_ = DWT->CYCCNT; ui_task_ = task; }
+  inline void UiInputs() { ui_inputs_ = DWT->CYCCNT; }
+
+  void Prepare(Patch* patch, Modulations* m) {
+    const StockScene& s = scenes_[phase_ == PHASE_SCENES ? scene_ : 0];
+    const bool active = phase_ == PHASE_SCENES;
+    patch->engine = s.engine;
+    patch->note = active ? s.note : 60.0f;
+    patch->harmonics = active ? s.harmonics : 0.5f;
+    patch->timbre = active ? s.timbre : 0.5f;
+    patch->morph = active ? s.morph : 0.5f;
+    patch->frequency_modulation_amount = 0.0f;
+    patch->timbre_modulation_amount = 0.0f;
+    patch->morph_modulation_amount = 0.0f;
+    patch->decay = 0.5f;
+    patch->lpg_colour = 0.5f;
+    m->engine = m->note = m->frequency = m->harmonics = 0.0f;
+    m->timbre = m->morph = m->level = 0.0f;
+    m->frequency_patched = m->timbre_patched = m->morph_patched = false;
+    m->level_patched = false;
+    m->trigger_patched = active && s.triggered;
+    m->trigger = active && s.triggered &&
+        (block_ % kTriggerPeriod) < kTriggerLength ? 1.0f : 0.0f;
+  }
+
+  inline void EndRender() {
+    if (phase_ == PHASE_SCENES) {
+      const uint32_t cycles = DWT->CYCCNT - start_;
+      Stats& s = stats_[scene_];
+      if (block_ < kSwitchBlocks) {
+        if (cycles > s.switch_max) s.switch_max = cycles;
+      } else {
+        if (cycles > s.max) s.max = cycles;
+        s.sum += cycles;
+        ++s.count;
+        const uint32_t section[kSections] = {
+          mark_[1] - start_, mark_[2] - mark_[1], mark_[3] - mark_[2],
+          start_ + cycles - mark_[3] };
+        for (int k = 0; k < kSections; ++k) {
+          s.section_sum[k] += section[k];
+          if (section[k] > s.section_max[k]) s.section_max[k] = section[k];
+        }
+        if (ui_task_ >= 0 && ui_task_ < kUiTasks) {
+          const uint32_t t = task_mark_ - ui_inputs_;
+          task_sum_[ui_task_] += t;
+          ++task_count_[ui_task_];
+          if (t > task_max_[ui_task_]) task_max_[ui_task_] = t;
+        }
+      }
+    }
+    if (phase_ == PHASE_REPORT) return;
+    ++block_;
+    if (phase_ == PHASE_START && block_ >= kStartBlocks) {
+      phase_ = PHASE_SCENES; scene_ = 0; block_ = 0;
+    } else if (phase_ == PHASE_SCENES && block_ >= kSceneBlocks) {
+      block_ = 0;
+      if (++scene_ >= kScenes) { scene_ = kScenes - 1; phase_ = PHASE_REPORT; }
+    }
+  }
+
+  void WriteStart(Voice::Frame* frames, size_t size) {
+    if (phase_ != PHASE_START) return;
+    for (size_t i = 0; i < size; ++i) {
+      if (fsk_.transmitting()) frames[i].aux = fsk_.Sample();
+    }
+  }
+
+  void WriteReport(Voice::Frame* frames, size_t size) {
+    for (size_t i = 0; i < size; ++i) {
+      if (!fsk_.transmitting()) {
+        if (report_gap_ > 0) --report_gap_; else EnqueueReportItem();
+      }
+      frames[i].out = 0;
+      frames[i].aux = fsk_.transmitting() ? fsk_.Sample() : 0;
+    }
+  }
+
+ private:
+  struct Stats {
+    uint32_t max, sum, switch_max, count;
+    uint32_t section_sum[kSections], section_max[kSections];
+  };
+
+  uint16_t Code(uint32_t cycles) const {
+    const uint32_t code = static_cast<uint32_t>(
+        (static_cast<uint64_t>(cycles) * 1000u + budget_ / 2) / budget_);
+    return static_cast<uint16_t>(code > 0xffff ? 0xffff : code);
+  }
+
+  void EnqueueReportItem() {
+    if (report_scene_ == kScenes) {
+      fsk_.BeginPacket(11, kUiTasks * 4);
+      for (int k = 0; k < kUiTasks; ++k) {
+        fsk_.Put16(Code(task_count_[k] ? task_sum_[k] / task_count_[k] : 0));
+        fsk_.Put16(Code(task_max_[k]));
+      }
+      fsk_.EndPacket();
+      report_scene_ = 0;
+      report_gap_ = 47872;
+      return;
+    }
+    const Stats& s = stats_[report_scene_];
+    fsk_.BeginPacket(10, 1 + kSections * 4);
+    fsk_.Put(static_cast<uint8_t>(report_scene_));
+    for (int k = 0; k < kSections; ++k) {
+      fsk_.Put16(Code(s.count ? s.section_sum[k] / s.count : 0));
+      fsk_.Put16(Code(s.section_max[k]));
+    }
+    fsk_.EndPacket();
+    fsk_.BeginPacket(9, 14);
+    fsk_.Put(static_cast<uint8_t>(report_scene_));
+    fsk_.Put(static_cast<uint8_t>(scenes_[report_scene_].engine));
+    fsk_.Put16(Code(s.max));
+    fsk_.Put16(Code(s.count ? s.sum / s.count : 0));
+    fsk_.Put16(0);                        // no DAC late probe upstream
+    fsk_.Put16(Code(s.switch_max));
+    fsk_.Put16(0);
+    fsk_.Put16(static_cast<uint16_t>(s.count / 16));
+    fsk_.EndPacket();
+    ++report_scene_;
+  }
+
+  const StockScene* scenes_;
+  Phase phase_;
+  int scene_, block_;
+  uint32_t start_, budget_;
+  uint32_t mark_[4];
+  uint32_t ui_inputs_, task_mark_;
+  int ui_task_;
+  Stats stats_[kScenes];
+  uint32_t task_sum_[kUiTasks], task_max_[kUiTasks], task_count_[kUiTasks];
+  DiagnosticFsk<96> fsk_;
+  int report_scene_, report_gap_;
+};
+
+}  // namespace plaits
+
+#endif
